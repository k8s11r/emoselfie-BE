{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "INFERENCE_BACKEND=real EMOTION_MODEL_PATH=.models/FER_static_ResNet50_AffectNet.pt FACE_MODEL_PATH=.models/blaze_face_short_range.tflite exec .venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../emoselfie-FE && exec pnpm dev --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
