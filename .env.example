APP_ENV=development
# 로컬 HTTP 브라우저 세션이 필요할 때만 true. HTTPS에서는 Secure를 유지한다.
ALLOW_INSECURE_COOKIE=false
INFERENCE_BACKEND=fake
DATABASE_URL=postgresql+asyncpg://emoselfie:local-development@127.0.0.1:55432/emoselfie
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_MEDIA_URL=redis://127.0.0.1:56380/0
# Generate separate random values with: uv run python scripts/init_env.py
COOKIE_SECRET=
COOKIE_SECRET_PREVIOUS=
CAPTURE_TOKEN_SECRET=
MEDIA_TOKEN_SECRET=
EMOTION_MODEL_VERSION=v1
EMOTION_MODEL_PATH=/models/emotion/v1/FER_static_ResNet50_AffectNet.pt
FACE_MODEL_VERSION=v1
FACE_MODEL_PATH=/models/face/v1/blaze_face_short_range.tflite
INFERENCE_CONCURRENCY=2
INFERENCE_TIMEOUT_SEC=5.0
INFERENCE_QUEUE_CAPACITY=24
INFERENCE_TORCH_THREADS=1
MAX_UPLOAD_BYTES=2097152
MAX_IMAGE_PIXELS=4194304
HOST_GRACE_SEC=60
PARTICIPANT_GRACE_SEC=60
ROOM_IDLE_EXPIRE_SEC=1800
SCHEDULER_TICK_MS=250
